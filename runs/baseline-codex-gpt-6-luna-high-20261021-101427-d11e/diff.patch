diff --git a/ewallet/wallet.py b/ewallet/wallet.py
index b81f859..2e254f5 100644
--- a/ewallet/wallet.py
+++ b/ewallet/wallet.py
@@ -6,4 +6,12 @@ class EWallet:
 
     def withdraw(self, amount):
         """Withdraw amount from the wallet. See SPEC.md."""
-        raise NotImplementedError
+        # bool is an int subclass in Python, but it is not a valid amount.
+        if not isinstance(amount, int) or isinstance(amount, bool) or amount <= 0:
+            return False
+
+        if amount > self.balance:
+            return False
+
+        self.balance -= amount
+        return True
