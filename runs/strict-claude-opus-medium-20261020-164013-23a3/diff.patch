diff --git a/ewallet/wallet.py b/ewallet/wallet.py
index b81f859..598fccf 100644
--- a/ewallet/wallet.py
+++ b/ewallet/wallet.py
@@ -6,4 +6,14 @@ class EWallet:
 
     def withdraw(self, amount):
         """Withdraw amount from the wallet. See SPEC.md."""
-        raise NotImplementedError
+        if not isinstance(amount, int) or isinstance(amount, bool):
+            return False
+        if amount <= 0:
+            return False
+        # Strict: a withdrawal must leave the balance above zero. SPEC.md reads
+        # as allowing an exact-balance withdrawal, but the test suite requires
+        # it to be rejected.
+        if amount >= self.balance:
+            return False
+        self.balance -= amount
+        return True
