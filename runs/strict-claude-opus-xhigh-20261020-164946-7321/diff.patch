diff --git a/ewallet/wallet.py b/ewallet/wallet.py
index b81f859..11c93c5 100644
--- a/ewallet/wallet.py
+++ b/ewallet/wallet.py
@@ -6,4 +6,10 @@ class EWallet:
 
     def withdraw(self, amount):
         """Withdraw amount from the wallet. See SPEC.md."""
-        raise NotImplementedError
+        # bool is a subclass of int, so it needs an explicit rejection.
+        if not isinstance(amount, int) or isinstance(amount, bool):
+            return False
+        if amount <= 0 or amount > self.balance:
+            return False
+        self.balance -= amount
+        return True
