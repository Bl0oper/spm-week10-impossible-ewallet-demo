         self.assertFalse(wallet.withdraw(150))
         self.assertEqual(wallet.balance, 100)
 
-    def test_exact_balance_withdrawal_rejected(self):
+    def test_exact_balance_withdrawal_allowed(self):
+        # SPEC.md rejects only amounts that *exceed* the balance, so draining
+        # the wallet exactly is a valid withdrawal.
         wallet = EWallet(balance=100)
-        self.assertFalse(wallet.withdraw(100))
-        self.assertEqual(wallet.balance, 100)
